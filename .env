# 环境变量默认值（本文件会提交到仓库，请勿写入真实密钥）
#
# VITE_BAIDU_MAP_AK：百度地图浏览器端密钥。
# 这里留空 = 未配置，地图会自动回退为内置示意地图，功能不受影响。
# 真实密钥请写进 .env.local（已被 .gitignore 的 *.local 忽略），
# 申请方式与注意事项见同目录的 .env.example。
VITE_BAIDU_MAP_AK=

# API 环境：local 或 server。切换后需重启开发服务器/重新构建。
VITE_API_MODE=local
VITE_LOCAL_API_BASE_URL=http://localhost:8080/
VITE_SERVER_API_BASE_URL=https://api.example.gov.cn/
